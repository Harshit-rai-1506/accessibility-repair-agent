# Copy this file to ".env" on your laptop and fill in your key.
# ".env" is git-ignored, so git will never upload it. Never create .env
# through the GitHub website: that skips .gitignore and publishes the key.

# --- Model -------------------------------------------------------------
# Format is "provider:model". Two hosted providers are set up, both with a
# free tier and no credit card needed; fill in the key for the one you use.
#
#   Groq:    MODEL=groq:openai/gpt-oss-120b       OpenAI's open-weight gpt-oss
#            key from https://console.groq.com/keys
#            free tier: 30 requests and 8,000 tokens per minute, 200,000 tokens per day
#
#   Mistral: MODEL=mistralai:mistral-small-2603   Mistral Small 4 (open weights, Apache 2.0)
#            key from https://console.mistral.ai/api-keys
#            free tier: 1 request per second, 500,000 tokens per minute
#
# Results are compared per model, so run every method with the same MODEL.
MODEL=groq:openai/gpt-oss-120b
GROQ_API_KEY=
MISTRAL_API_KEY=

# A second model with its own free daily quota, used when the first one
# hits its limit and for model-size comparisons.
FALLBACK_MODEL=groq:openai/gpt-oss-20b

# gpt-oss "thinks" before answering. "low" keeps token use (and free-tier
# limits) under control; try "medium" if fixes are poor. (gpt-oss only.)
REASONING_EFFORT=low

# --- Rate limits ---------------------------------------------------------
# Each provider has built-in pacing a little below its free tier
# (src/a11y_agent/config.py, PROVIDER_LIMITS), so you normally set nothing here.
# On a paid plan, override per provider; 0 means no limit:
# GROQ_RATE_LIMIT_TPM=0
# GROQ_RATE_LIMIT_RPM=0
# GROQ_MAX_REQUEST_TOKENS=60000
# MISTRAL_RATE_LIMIT_RPM=0
# MISTRAL_MIN_INTERVAL=0
# (Older .env files may have RATE_LIMIT_TPM, RATE_LIMIT_RPM and
# MAX_REQUEST_TOKENS without a prefix: they still work, for Groq only.)

# Fully offline alternative (slow on a laptop CPU). Install Ollama, run
# "ollama pull qwen2.5-coder:3b", then switch MODEL to:
# MODEL=ollama:qwen2.5-coder:3b

# --- Guardrails (Phase 5) ----------------------------------------------------
# Pages are screened for prompt injection before the model sees them: by rules
# always, and by Meta's Llama Prompt Guard 2 classifier on Groq whenever
# GROQ_API_KEY is set (free; separate limits from the chat models). Set
# PROMPT_GUARD_MODEL=none to use the rules only. A piece of text counts as an
# attack when the classifier's probability is at least the threshold.
# PROMPT_GUARD_MODEL=groq:meta-llama/llama-prompt-guard-2-86m
# PROMPT_GUARD_THRESHOLD=0.5

# --- Accessibility engine ---------------------------------------------------
# Must match the version downloaded by scripts/fetch_resources.py
AXE_VERSION=4.12.1

# --- Optional: LangSmith tracing (free developer tier) ----------------------
# Shows every model call and tool call as a timeline. Useful from Phase 2.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=accessibility-repair-agent
